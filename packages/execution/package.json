{
  "name": "@semantic-dapp/execution",
  "version": "0.1.2",
  "description": "viem/wagmi reads, simulation, writes, receipts and error decoding for Semantic Dapp.",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/TacitvsXI/semantic-dapp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TacitvsXI/semantic-dapp.git",
    "directory": "packages/execution"
  },
  "bugs": {
    "url": "https://github.com/TacitvsXI/semantic-dapp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run test/integration",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@semantic-dapp/spec": "workspace:*",
    "viem": "^2.55.8"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.62.0",
    "react": "^18.3.1",
    "wagmi": "^2.14.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "wagmi": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "react": "^18.3.1",
    "wagmi": "^2.14.6"
  }
}
