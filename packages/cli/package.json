{
  "name": "@semantic-dapp/cli",
  "version": "0.1.2",
  "description": "semantic-dapp CLI: turn an ABI into a bundle and export a standalone app.",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/TacitvsXI/semantic-dapp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TacitvsXI/semantic-dapp.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/TacitvsXI/semantic-dapp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "semantic-dapp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@semantic-dapp/classifier": "workspace:*",
    "@semantic-dapp/export": "workspace:*",
    "@semantic-dapp/spec": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  }
}
